{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/feed",
      "destination": "/api/rss"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "15 0,3,7,9 * * *"
    }
  ]
}
